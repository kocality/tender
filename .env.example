# Tender environment variables. Copy to .env (git-ignored) and fill in locally.
# Never commit real values. Keys for manual ops live in the near-cli-rs keychain, not here.
# Only relayer/keeper automation reads private keys, from env or CI secrets.

# --- Network and RPC (public, keyless defaults verified 2026-11-09) ---
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://free.rpc.fastnear.com
# comma-separated, tried in order after NEAR_RPC_URL
NEAR_RPC_FALLBACKS=https://rpc.mainnet.near.org
# archival: needed only for the 1-2 history checks in `pnpm verify` (WARN, not FAIL, on provider errors)
NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.mainnet.fastnear.com
NEAR_ARCHIVAL_RPC_FALLBACKS=https://archival-rpc.mainnet.near.org
NEARBLOCKS_API_URL=https://api.nearblocks.io
# optional
NEARBLOCKS_API_KEY=

# testnet rehearsal (Wed evening): keyless-creation batch + CKD from the contract
NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com
TESTNET_MPC_CONTRACT_ID=v1.signer-prod.testnet
TESTNET_ACCOUNT_ID=
TESTNET_PRIVATE_KEY=

# --- Contracts and accounts ---
TENDER_TEAM_ACCOUNT_ID=tenderseal.near
TENDER_CONTRACT_ID=v1.tenderseal.near
TENDER_REHEARSAL_CONTRACT_ID=rehearsal.tenderseal.near
MPC_CONTRACT_ID=v1.signer
MPC_DOMAIN_ID=2
# identity | generator | plain (decided by gate S1, fixed in new())
MPC_APP_PK_MODE=
INTENTS_CONTRACT_ID=intents.near
QUOTE_TOKEN_ID=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1

# --- Relayer (relayer.tenderseal.near, hot key, <= 0.5 NEAR) ---
RELAYER_ACCOUNT_ID=relayer.tenderseal.near
# ed25519:... SECRET
RELAYER_PRIVATE_KEY=

# Public key of the relayer key. Optional; with a private key set it must match, otherwise the relayer refuses to start
RELAYER_PUBLIC_KEY=
# comma-separated browser origins allowed to call POST /relay (pnpm relay:local defaults to the local app, 5173 and 4173)
RELAY_ALLOWED_ORIGINS=http://localhost:5173
# pnpm relay:local only
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
# 1 accepts a relayer key that is not a function-call key. Humans only; ignored when VERCEL is set
RELAY_ALLOW_FULL_ACCESS=
# testnet: set NEAR_NETWORK=testnet (TENDER_NETWORK is read as a fallback)
TENDER_NETWORK=
# where the ops scripts look for keys when no env key is set
NEAR_CREDENTIALS_DIR=~/.near-credentials
# ops scripts: signer of the bid and spike scripts
TENDER_BIDDER_ACCOUNT_ID=bidder.tenderseal.near
TENDER_SPIKE_ACCOUNT_ID=spike.tenderseal.near

# --- Keeper (open / reveal / finalize; GitHub Actions secret for sale #2 on 2026-11-17) ---
KEEPER_ACCOUNT_ID=tenderseal.near
# ed25519:... SECRET. Prefer a function-call access key limited to the Tender contract.
KEEPER_PRIVATE_KEY=
# optional; picks the matching key from the credentials file
KEEPER_PUBLIC_KEY=

# --- 1Click ---
ONECLICK_API_URL=https://1click.chaindefuser.com
# optional (Q-006: without it 0.2% fee). SECRET
ONECLICK_JWT=

# --- Frontend (Vite exposes only VITE_* to the browser: never put secrets here) ---
VITE_NETWORK=mainnet
VITE_NEAR_RPC_URL=https://free.rpc.fastnear.com
VITE_NEAR_RPC_FALLBACKS=https://rpc.mainnet.near.org
VITE_TENDER_CONTRACT_ID=v1.tenderseal.near
VITE_INTENTS_CONTRACT_ID=intents.near
VITE_MPC_CONTRACT_ID=v1.signer
# receiver of the free "Try signing" payload; empty = the Tender contract
VITE_TRY_RECEIVER=
VITE_RELAYER_URL=
VITE_ONECLICK_API_URL=https://1click.chaindefuser.com
VITE_TWIN_SALES=1,0
# accounts whose sales are labelled team-funded
VITE_TEAM_ACCOUNTS=tenderseal.near
# sale ids shown as "configured by us to miss its open thresholds" (default 0 on mainnet, empty on testnet)
VITE_DEMO_FAIL_SALES=0
# empty = the mainnet / testnet default for VITE_NETWORK
VITE_NEARBLOCKS_API_URL=
VITE_EXPLORER_URL=
