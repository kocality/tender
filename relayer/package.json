{
  "name": "@tender/relayer",
  "version": "0.0.0",
  "private": true,
  "description": "Permissionless relayer (POST /relay: simulate_intents then execute_intents), keeper and ops scripts",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "relay:local": "tsx src/local-server.ts",
    "keeper": "tsx src/keeper.ts",
    "watch": "tsx scripts/watch.ts",
    "record": "tsx scripts/record.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "balances": "tsx scripts/balances.ts",
    "keys": "tsx scripts/keys.ts",
    "birth": "tsx scripts/birth.ts",
    "sale": "tsx scripts/sale.ts",
    "bid": "tsx scripts/bid-nep413.ts",
    "attack": "tsx scripts/attack-bids.ts",
    "s3b": "tsx scripts/s3b.ts",
    "s5": "tsx scripts/s5-return.ts",
    "swap": "tsx scripts/swap-intents.ts",
    "evidence-check": "tsx scripts/evidence-check.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tender/clearing": "workspace:*",
    "@tender/intents": "workspace:*",
    "@tender/seal": "workspace:*",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
