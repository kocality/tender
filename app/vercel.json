{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd .. && npx --yes pnpm@12.18.0 install --frozen-lockfile",
  "buildCommand": "cd .. && npx --yes pnpm@12.18.0 --filter @tender/app build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
